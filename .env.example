# code hashes, delegation and private MEV submission path have all been proven.
PROTOCOL_REVENUE_AUTOMATION_ENABLED=false
PROTOCOL_REVENUE_EXECUTOR_ADDRESS=
PROTOCOL_REVENUE_EXECUTOR_CODE_HASH=
