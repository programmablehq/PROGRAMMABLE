# Required for Privy wallet sign-in. This public App ID comes from the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# BTC prediction markets stay fail-closed until these values bind the Website
# to one reviewed Robinhood Chain deployment and its quoting path. Browser
# reads compare Robinhood's official endpoint with a domain-restricted Alchemy
# Robinhood endpoint; no hosted backend is required.
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_FACTORY_ADDRESS=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_FACTORY_RUNTIME_CODE_HASH=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_ROUTER_RUNTIME_CODE_HASH=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_HOOK_RUNTIME_CODE_HASH=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_QUOTER_ADDRESS=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_QUOTER_RUNTIME_CODE_HASH=
NEXT_PUBLIC_PROGRAMMABLE_PREDICTION_SECONDARY_RPC_URL=

# Optional future Prediction V2 server-only identity reads. Configure every
# required URL before enabling arbitrary-token discovery; missing or mismatched
# RPC identity keeps discovery inconclusive. Values must be credential-free in
# this committed example and use HTTPS in deployed environments.
PROGRAMMABLE_PREDICTION_V2_ETHEREUM_RPC_URL=
PROGRAMMABLE_PREDICTION_V2_BASE_RPC_URL=
PROGRAMMABLE_PREDICTION_V2_BNB_RPC_URL=
# This URL is only a source-network identity probe for Robinhood assets. It is
# not trusted for Prediction V2 settlement, quoting, or transaction preflight.
PROGRAMMABLE_PREDICTION_V2_ROBINHOOD_RPC_URL=
PROGRAMMABLE_PREDICTION_V2_SOLANA_RPC_URL=

# Server-only create-preview logo capability. Generate a cryptographically
# random secret in the deployment secret manager. Capabilities are bound to the
# exact verified signed release and expire in a bounded five-minute bucket; use
# the epoch for emergency revocation. Never expose either value through
# NEXT_PUBLIC_ variables.
PREDICTION_V2_ASSET_LOGO_CAPABILITY_HMAC_KEY=
PREDICTION_V2_ASSET_LOGO_CAPABILITY_KEY_EPOCH=

# Prediction V2 Robinhood settlement reads stay release-dark unless one
# production-capable server-only HTTPS endpoint is fully bound to the signed
# release. Commitments are keccak256 domain-separated values produced by the
# release tooling; never place URLs or credentials in NEXT_PUBLIC_ variables.
# The official rate-limited Robinhood RPC is deliberately rejected by this
# reader. A single provider cannot independently detect a consistently false
# canonical view, so unavailable or internally inconsistent reads fail closed.
PROGRAMMABLE_PREDICTION_V2_SETTLEMENT_RPC_PROVIDER_ID=
PROGRAMMABLE_PREDICTION_V2_SETTLEMENT_RPC_PROVIDER_COMMITMENT=
PROGRAMMABLE_PREDICTION_V2_SETTLEMENT_RPC_VENDOR_GROUP=
PROGRAMMABLE_PREDICTION_V2_SETTLEMENT_RPC_VENDOR_COMMITMENT=
PROGRAMMABLE_PREDICTION_V2_SETTLEMENT_RPC_URL=
PROGRAMMABLE_PREDICTION_V2_SETTLEMENT_RPC_ENDPOINT_COMMITMENT=

# Required by server routes that verify Privy access tokens.
PRIVY_APP_SECRET=

# V4 migration page release controls. The public route and landing-page entry
# may show the inactive 72-hour preview before an exact window is finalized.
# The checked-in activation manifest remains the authority for the timer,
# official address, wallet actions and production transfers.
PROGRAMMABLE_MAIN_TOKEN_MIGRATION_PAGE_ENABLED=false
NEXT_PUBLIC_PROGRAMMABLE_MAIN_TOKEN_MIGRATION_PAGE_VISIBLE=false
PROGRAMMABLE_MAIN_TOKEN_MIGRATION_LOCAL_PREVIEW=false

# Optional, server-only V4 migration gas sponsor for the reviewed 72-hour
# release. This remains fail-closed until
# the signed migration activation manifest is enabled and every value below is
# configured. Use a dedicated, policy-limited Privy EOA with a deliberately
# bounded ETH balance. Never use the migration recipient wallet as the sponsor.
# The Privy wallet must have exactly the configured policy attached. That policy
# must permit only Ethereum Mainnet native eth_sendTransaction top-ups with a
# value ceiling no higher than 0.002 ETH. Privy's transaction policy does not
# attest calldata or the dynamic holder recipient; runtime binds both itself.
# Runtime also enforces a 20 gwei max-fee ceiling, a 125% transfer-gas quote multiplier, a
# fixed 21,000-gas sponsor transfer and a 1 ETH absolute release-budget ceiling.
# Keep all operational values blank in committed files; inject them only through
# the deployment secret manager. The complete activation and readiness contract
# is docs/operations/MAIN-TOKEN-MIGRATION-GAS-SPONSOR-V1.md.
MAIN_TOKEN_MIGRATION_GAS_SPONSOR_ENABLED=false
MAIN_TOKEN_MIGRATION_GAS_SPONSOR_PRIVY_WALLET_ID=
MAIN_TOKEN_MIGRATION_GAS_SPONSOR_PRIVY_POLICY_ID=
MAIN_TOKEN_MIGRATION_GAS_SPONSOR_ADDRESS=
MAIN_TOKEN_MIGRATION_GAS_SPONSOR_MAX_TOP_UP_WEI=
MAIN_TOKEN_MIGRATION_GAS_SPONSOR_TOTAL_BUDGET_WEI=

# GitHub App user-to-server launch authority. The Website receives `ghu_`
# tokens only through the registered PKCE callback, seals them in an HttpOnly
# cookie, revalidates them with GitHub, and signs a 30-second release-bound
# assertion. Keep the client secret, Ed25519 private key and 32-byte base64url
# cookie key server-only. VERCEL_GIT_COMMIT_SHA must equal the release commit.
PROGRAMMABLE_GITHUB_LAUNCH_APP_CLIENT_ID=
PROGRAMMABLE_GITHUB_LAUNCH_APP_CLIENT_SECRET=
PROGRAMMABLE_WEBSITE_GITHUB_LAUNCH_SESSION_SIGNER_KEY_ID=
PROGRAMMABLE_WEBSITE_GITHUB_LAUNCH_SESSION_SIGNER_PRIVATE_KEY_PEM=
PROGRAMMABLE_WEBSITE_GITHUB_LAUNCH_COOKIE_SEAL_KEY_BASE64URL=

# Custom Launch website projection target. Use a dedicated PostgreSQL role
# whose only runtime privileges are SELECT and INSERT on the immutable tables.
PROGRAMMABLE_WEBSITE_PROJECTION_DATABASE_URL=
PROGRAMMABLE_WEBSITE_PROJECTION_DATABASE_ROLE=programmable_website_projection_runtime
# Supabase Server root certificate. Literal \n escapes are accepted.
PROGRAMMABLE_WEBSITE_PROJECTION_DATABASE_CA_PEM=
PROGRAMMABLE_APPROVAL_SERVICE_V2_ORIGIN=
# Exact identity reported by the approval service /readyz endpoint.
PROGRAMMABLE_APPROVAL_SERVICE_EXPECTED_PACKAGE_ARTIFACT_HASH=
# Exact deployed service mode: manual_review or autonomous_ai.
PROGRAMMABLE_APPROVAL_SERVICE_EXPECTED_REVIEW_AUTHORITY_MODE=
# Keep Custom Launch closed unless this switch, the finalized Registry read
# switch, and every authority/runtime binding are valid.
PROGRAMMABLE_CUSTOM_LAUNCH_PUBLIC_ENABLED=false
# Independent Applicant-owned Router lane. This does not activate or alter the
# legacy Custom Launch service and remains closed unless every strict server
# dependency (Privy, private Blob and both named Mainnet RPCs) is available.
# Inject the exact reviewed Git commit into every immutable release candidate.
PROGRAMMABLE_RELEASE_COMMIT_SHA=
# JSON array of pinned Ed25519 permit signers. Retain old signer entries while
# unexpired permits from their epochs may still be used.
PROGRAMMABLE_LAUNCH_PERMIT_SIGNERS_V2_JSON=
# Remote token-image receipt signer, bound to its exact Ed25519 identity.
PROGRAMMABLE_TOKEN_IMAGE_UPLOAD_RECEIPT_SIGNER_V1_JSON=
PROGRAMMABLE_WEBSITE_PROJECTION_AUDIENCE=
PROGRAMMABLE_WEBSITE_ENTITLEMENT_TARGET_BINDING_HASH=
PROGRAMMABLE_WEBSITE_CUSTOM_LAUNCH_TARGET_BINDING_HASH=

# Registry V2 finalized public read model. These signed bindings must identify
# the same live Registry V2 and exact production signer before dark readiness
# can pass. The projector token authorizes immediate Approval V3 projection;
# Vercel's CRON_SECRET protects the bounded reconciliation fallback.
PROGRAMMABLE_GENERIC_LAUNCH_READ_BINDING_V2_JSON=
PROGRAMMABLE_GENERIC_LAUNCH_READ_MODEL_CONTRACT_V2_JSON=
PROGRAMMABLE_GENERIC_LAUNCH_READ_SIGNER_V2_JSON=
PROGRAMMABLE_APPROVAL_V3_ARTIFACT_VERIFIER_BINDING_JSON=
PROGRAMMABLE_GENERIC_LAUNCH_PROJECTOR_TOKEN=
PROGRAMMABLE_WEBSITE_APPROVAL_V3_AUDIENCE=
PROGRAMMABLE_WEBSITE_APPROVAL_V3_TARGET_BINDING_HASH=
PROGRAMMABLE_APPROVAL_V3_WORKLOAD_ISSUER=
PROGRAMMABLE_APPROVAL_V3_WORKLOAD_SUBJECT=
PROGRAMMABLE_APPROVAL_V3_WORKLOAD_KEY_ID=
PROGRAMMABLE_APPROVAL_V3_WORKLOAD_PUBLIC_KEY_PEM=

