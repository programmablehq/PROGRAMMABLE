# Staged-candidate-only SLA probe. Leave false outside the one explicitly
# armed, unaliased Vercel candidate used to prove QuickNode's real retry path.
PROGRAMMABLE_REAL_BLOCK_SLA_FORCE_PROVIDER_RETRY_ONCE=false

# Required by release tooling when publishing and checking source
# verification on Etherscan.
ETHERSCAN_API_KEY=

# Deep V2 read-only deployment simulation and post-deployment receipt capture.
