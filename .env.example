DEEP_V3_LAUNCHER_TRANSACTION=
DEEP_V3_RELEASE_COMMIT=
# Required by Vercel Cron when refreshing the durable Mainnet index.
CRON_SECRET=

# Project execution stays off until its isolated runtime and resources are configured.
CUSTOM_AI_PLATFORM_ENABLED=false

# Immutable protocol-revenue deployment and restricted Vercel keeper. Keep the
